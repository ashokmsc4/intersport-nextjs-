# Magento 2 backend (use staging during development)
MAGENTO_BASE_URL=https://intersport.uat.aawweb.com
# Production: MAGENTO_BASE_URL=https://www.intersport.com.kw

# User-Agent sent to Magento. Production's firewall returns 403 for unknown agents
# (including Node's default); the mobile app sends "Dart/2.10 (dart:io)". Ask the
# hosting team to allow a dedicated agent for the web storefront and set it here.
MAGENTO_USER_AGENT=

# Production's AWS WAF serves its bot check ("Human Verification" page) to cloud hosts
# such as Vercel. Ask the hosting team for a WAF rule that allows requests carrying
# this header, and put the agreed name and secret value here. Server-only.
MAGENTO_ACCESS_HEADER_NAME=
MAGENTO_ACCESS_HEADER_VALUE=

# Magento store view codes per storefront locale
MAGENTO_STORE_CODE_EN=intersport_en
MAGENTO_STORE_CODE_AR=intersport_ar

# Optional. The storefront endpoints work without it; when set, it is sent as a
# Bearer token on non-customer calls. Server-only: never prefix with NEXT_PUBLIC_.
MAGENTO_INTEGRATION_TOKEN=

# Mobile-app settings files served from /media (config.json, categories.json, ...)
MAGENTO_APP_SETTINGS_PATH=/media/mobile-app/intersport
# Version folder for data/ files (older app builds used 2.0.1); empty for staging and production
MAGENTO_APP_SETTINGS_VERSION=

# Inventory stock used by salable-quantity checks (settings/config.json -> Setting.StockId; 2 on staging and production)
MAGENTO_STOCK_ID=2

# Image hosts that only the backend should use; URLs on them are rewritten to MAGENTO_BASE_URL
MAGENTO_BACKEND_MEDIA_HOSTS=prod.aaw.com

# Seconds to cache catalog responses (ISR)
MAGENTO_REVALIDATE_SECONDS=300

# Website id used for password reset emails
MAGENTO_WEBSITE_ID=3

# Serve images through /api/media instead of the Next.js optimizer (default: on for Vercel builds)
# IMAGE_PROXY=true
