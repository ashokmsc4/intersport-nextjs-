# Magento 2 backend (use staging during development)
MAGENTO_BASE_URL=https://intersport.uat.aawweb.com

# Magento store view codes per storefront locale
MAGENTO_STORE_CODE_EN=intersport_en
MAGENTO_STORE_CODE_AR=intersport_ar

# Integration token used for catalog and guest-cart REST calls.
# Server-only: never prefix with NEXT_PUBLIC_ and never commit a real value.
MAGENTO_INTEGRATION_TOKEN=

# Mobile-app settings files served from /media (config.json, categories.json, ...)
MAGENTO_APP_SETTINGS_PATH=/media/mobile-app/intersport
MAGENTO_APP_SETTINGS_VERSION=2.0.1

# Inventory stock used by salable-quantity checks
MAGENTO_STOCK_ID=17

# Seconds to cache catalog responses (ISR)
MAGENTO_REVALIDATE_SECONDS=300
